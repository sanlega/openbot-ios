{
  "name": "@openbot/server",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openbot": "./dist/main.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "development": "./src/bootstrap.ts",
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@openbot/computer-docker": "workspace:*",
    "@openbot/computer-fake": "workspace:*",
    "@openbot/computer-local": "workspace:*",
    "@openbot/connectors": "workspace:*",
    "@openbot/contracts": "workspace:*",
    "@openbot/core": "workspace:*",
    "@openbot/cos": "workspace:*",
    "@openbot/decisions": "workspace:*",
    "@openbot/engines-acp": "workspace:*",
    "@openbot/engines-claude": "workspace:*",
    "@openbot/engines-codex": "workspace:*",
    "@openbot/engines-common": "workspace:*",
    "@openbot/engines-fake": "workspace:*",
    "@openbot/mcp": "workspace:*",
    "@openbot/pwa": "workspace:*",
    "@openbot/remote": "workspace:*",
    "@openbot/routines": "workspace:*",
    "@openbot/runtime": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@openbot/testkit": "workspace:*",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
