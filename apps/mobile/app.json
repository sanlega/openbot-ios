{
  "expo": {
    "name": "OpenBot",
    "slug": "openbot-mobile",
    "scheme": "openbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.openbot.mobile",
      "config": {
        "usesNonExemptEncryption": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpenBot uses your camera to scan a pairing QR code from your desktop."
        }
      ],
      "react-native-libsodium"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
