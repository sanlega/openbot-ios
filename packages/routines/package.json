{
  "name": "@openbot/routines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @openbot/core run build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openbot/contracts": "workspace:*",
    "@openbot/core": "workspace:*",
    "@openbot/runtime": "workspace:*",
    "chokidar": "4.0.3",
    "croner": "9.0.0",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openbot/decisions": "workspace:*",
    "@openbot/testkit": "workspace:*",
    "@types/node": "22.20.4",
    "fastify": "5.12.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
