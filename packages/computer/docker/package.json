{
  "name": "@openbot/computer-docker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/desktop-daemon.ts --bundle --platform=node --format=esm --outfile=dist/desktop-daemon.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openbot/computer": "workspace:*",
    "@openbot/contracts": "workspace:*",
    "dockerode": "4.0.9"
  },
  "devDependencies": {
    "@openbot/testkit": "workspace:*",
    "@types/dockerode": "3.3.47",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
